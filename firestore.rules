rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // User secrets are written and read only by the Next.js Admin SDK. The
    // client does not need direct access to this document.
    match /users/{userId} {
      allow read, create, update, delete: if false;

      // Chats are encrypted in the browser and scoped to the authenticated
      // user's subcollection. These rules cover reads, listeners, writes, and
      // deletes on users/{uid}/chats/{chatId}.
      match /chats/{chatId} {
        allow read, create, update, delete: if
          request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
