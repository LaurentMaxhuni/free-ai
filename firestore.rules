rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users can read/write their own user document, but the server (via Admin SDK)
    // is the only one that should ever read the `secrets` field back. We lock it
    // down by denying reads and only allowing writes of the `secrets` field
    // through the authenticated client. The actual secret values are written by
    // the Next.js API route using the Admin SDK, so this rule primarily serves
    // as a safety net.
    match /users/{userId} {
      allow read, delete: if false;
      allow create, update: if request.auth != null && request.auth.uid == userId;
    }
  }
}
